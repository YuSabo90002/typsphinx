# uv
.uv/
# uv.lock is tracked (PIN-03): the committed lock is the reproducibility source of truth

# gsd-pi project-local npm global prefix (created by the flake devshell)
/.gsd-pi/

# GSD (Get Shit Done) — installed per-developer via `npx gsd-core`.
# The install bakes machine-specific absolute paths, so it stays local.
.claude/

# GSD run-scoped state (e.g. dispatch-isolation-sentinel.json, written per
# execute-phase run so the isolation guard hooks can read the resolved mode).
# Ephemeral and machine-local — never meaningful in another checkout.
/.gsd/

# gsd-core's machine-readable state contract (#3227, schema v1), republished at
# every step-boundary command (state.*, phase.*, milestone.complete). It is a
# derived snapshot — fully regenerable from ROADMAP.md/STATE.md/config.json —
# and holds no truth of its own. Ignored rather than tracked because this
# project uses an empty `git status --porcelain` as phase-completion evidence,
# and a file rewritten by nearly every phase command would otherwise either
# leave the tree permanently dirty or have to be swept into unrelated commits.
/.planning/state.json

# MCP server config — the GSD install writes machine-specific absolute paths
# (nix store, /home/... prefixes) into it, so it stays local (must not reach main).
.mcp.json

# Claude Code background-shell scratch state (machine-local)
/.bg-shell/

# direnv — .envrc is tracked (`use flake`); the evaluated cache is machine-local
/.direnv/
/.envrc.local
