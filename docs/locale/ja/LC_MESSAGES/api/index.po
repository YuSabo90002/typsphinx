#: of typsphinx.translator.TypstTranslator.visit_line:3
msgid ""
"Emits a per-depth `h(...)` indent spacer for nested line_blocks "
"(D-03/D-04) -- a plain code-mode stdlib call, no markup-mode bracket-wrap"
" needed (unlike the Phase 11 `<label>`-anchor case, `h()` never carries a"
" label). An empty `line` node (no Text child) falls through to "
"depart_line's bare linebreak() for free -- no special-casing required."
msgstr ""

#: of typsphinx.translator.TypstTranslator.depart_line:1
msgid "Depart a line node."
msgstr ""

#: of typsphinx.translator.TypstTranslator.depart_line:3
msgid ""
"Emits a REAL `linebreak()` call -- a source '\\n' between two code-mode "
"statements is cosmetic-only (DESC-02 precedent), so this is what actually"
" produces the visible line break."
msgstr ""

