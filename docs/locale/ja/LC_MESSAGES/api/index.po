msgstr ""

#: of typsphinx.translator.TypstTranslator.visit_tabular_col_spec:3
msgid ""
"This is a LaTeX-only column-width hint with no Typst equivalent (BLK-05)."
" The node is self-closing, so raising SkipNode here safely drops it with "
"no risk of leaking the raw column-spec content into the compiled output."
msgstr ""

#: of typsphinx.translator.TypstTranslator.visit_abbreviation:1
msgid "Visit an abbreviation node (`:abbr:` role)."
msgstr ""

#: of typsphinx.translator.TypstTranslator.visit_abbreviation:3
msgid "No-op: the term's own Text child renders via the normal chain."
