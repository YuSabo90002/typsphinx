msgid "Depart a field_body node."
msgstr ""

#: of typsphinx.translator.TypstTranslator.depart_field_body:3
msgid ""
"Restore the concat context saved by :meth:`visit_field_body` and add a "
"newline after the field body."
msgstr ""

